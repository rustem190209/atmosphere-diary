{
  "name": "hackathon-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:fixtures": "npx --yes tsx scripts/check-fixtures.ts",
    "check:analyze": "npx --yes tsx scripts/check-analyze.ts",
    "check:style": "npx --yes tsx scripts/check-style.ts",
    "check": "npm run check:fixtures && npm run check:analyze && npm run check:style && npm run check:tempo && npm run check:v2",
    "check:tempo": "npx --yes tsx scripts/check-tempo.ts",
    "check:v2": "node tests/test-music-fusion.mts && node tests/test-camera.mts"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5"
  }
}
